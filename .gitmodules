[submodule "third_party/spdlog"]
	path = third_party/spdlog
	url = https://github.com/gabime/spdlog
[submodule "third_party/Bitstream"]
	path = third_party/Bitstream
	url = https://github.com/ireader/avcodec
[submodule "third_party/ByteTrack-cpp"]
	path = third_party/ByteTrack-cpp
	url = https://github.com/Vertical-Beach/ByteTrack-cpp.git
[submodule "third_party/libflv"]
	path = third_party/libflv
	url = https://github.com/BreakingY/libflv.git
[submodule "third_party/rtmpdump"]
	path = third_party/rtmpdump
	url = https://git.ffmpeg.org/rtmpdump.git
[submodule "third_party/simple-rtsp-client"]
	path = third_party/simple-rtsp-client
	url = https://github.com/BreakingY/simple-rtsp-client
[submodule "third_party/libmpeg2core"]
	path = third_party/libmpeg2core
	url = https://github.com/BreakingY/libmpeg2core
[submodule "third_party/pybind11"]
	path = third_party/pybind11
	url = https://github.com/pybind/pybind11.git
